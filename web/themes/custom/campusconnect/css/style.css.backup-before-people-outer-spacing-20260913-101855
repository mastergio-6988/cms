/* =========================================================
   CampusConnect — smooth editorial image motion
   ========================================================= */

.cc-home-feature {
  position: relative;
  overflow: hidden;
}

.cc-home-feature img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transform: scale(1.035);
  transition:
    opacity 1.2s ease,
    transform 6s ease;
}

.cc-home-feature img.is-active {
  opacity: 1;
  transform: scale(1);
}

.cc-home-feature img + img {
  position: absolute;
  inset: 0;
}

/* Gentle scroll reveal */

.cc-home-section,
.cc-list-card,
.cc-home-quicklink {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity .7s ease,
    transform .7s ease;
}

.cc-home-section.cc-visible,
.cc-list-card.cc-visible,
.cc-home-quicklink.cc-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Respect reduced-motion accessibility preference */

@media (prefers-reduced-motion: reduce) {
  .cc-home-feature img,
  .cc-home-section,
  .cc-list-card,
  .cc-home-quicklink {
    transition: none !important;
    transform: none !important;
  }

  .cc-home-feature img {
    opacity: 1;
  }

  .cc-home-feature img + img {
    display: none;
  }
}

/* Mobile stability */

@media (max-width: 700px) {
  .cc-home-feature img {
    min-height: 280px;
  }
}


