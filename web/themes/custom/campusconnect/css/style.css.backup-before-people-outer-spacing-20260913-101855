}

/* Feature image movement */
.cc-home-feature-media {
  position: relative;
}

.cc-home-feature-image {
  transition:
    transform .7s cubic-bezier(.2,.7,.2,1),
    opacity .7s ease;
}

.cc-home-feature-media:hover .cc-home-feature-image-one {
  transform: translate(-8px, -8px);
}

.cc-home-feature-media:hover .cc-home-feature-image-two {
  transform: translate(8px, 8px);
}

/* Text links */
.cc-text-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  position: relative;
  text-decoration: none;
  font-weight: 700;
}

.cc-text-link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 25px;
  bottom: -6px;
  height: 1px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s ease;
}

.cc-text-link:hover::after,
.cc-text-link:focus-visible::after {
  transform: scaleX(1);
}

.cc-text-link span {
  transition: transform .25s ease;
}

.cc-text-link:hover span {
  transform: translateX(5px);
}

/* Snapshot */
.cc-home-snapshot {
  position: relative;
  overflow: hidden;
}

.cc-home-section-heading {
  position: relative;
  z-index: 2;
}

.cc-home-section-heading h2 {
  max-width: 800px;
  text-wrap: balance;
}

.cc-home-snapshot-grid {
  position: relative;
  z-index: 2;
}

.cc-home-snapshot-card {
  position: relative;
  overflow: hidden;
  min-height: 190px;
  transition:
    transform .3s ease,
    box-shadow .3s ease;
}

.cc-home-snapshot-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, .10);
}

.cc-home-snapshot-card::before {
  content: "";
  position: absolute;
  inset: auto -30px -70px auto;
  width: 150px;
  height: 150px;
  border: 1px solid currentColor;
  border-radius: 50%;
  opacity: .08;
}

.cc-home-snapshot-card b {
  transition: transform .25s ease;
}

.cc-home-snapshot-card:hover b {
  transform: translateX(6px);
}

/* CTA */
.cc-home-cta {
  position: relative;
  overflow: hidden;
}

.cc-home-cta::after {
  content: "CC";
  position: absolute;
  right: -35px;
  bottom: -100px;
  font-size: clamp(14rem, 30vw, 32rem);
  line-height: .8;
  font-weight: 900;
  letter-spacing: -.1em;
  opacity: .04;
  pointer-events: none;
}

.cc-home-cta-inner {
  position: relative;
  z-index: 2;
}

.cc-home-cta h2 {
  text-wrap: balance;
}

.cc-home-cta-copy {
  max-width: 560px;
}

.cc-home-cta-copy p {
  line-height: 1.8;
}

/* Footer */
.cc-footer {
  position: relative;
  overflow: hidden;
}

.cc-footer-grid {
  position: relative;
  z-index: 2;
}

.cc-footer a {
  transition:
    opacity .2s ease,
    transform .2s ease;
}

.cc-footer a:hover,
.cc-footer a:focus-visible {
  opacity: .7;
  transform: translateX(3px);
}

/* Document-flow protection */
.cc-home-feature,
.cc-home-snapshot,
.cc-home-cta,
.cc-footer {
  clear: both;
  width: 100%;
}

.cc-home-feature-grid,
.cc-home-snapshot-grid,
.cc-home-cta-inner,
.cc-footer-grid {
  float: none;
}

/* Keyboard accessibility */
.cc-button:focus-visible,
.cc-text-link:focus-visible,
.cc-home-quicklink:focus-visible,
.cc-home-snapshot-card:focus-visible,
.cc-footer a:focus-visible {
  outline: 3px solid currentColor;
  outline-offset: 4px;
}

/* Mobile */
@media (max-width: 760px) {

  .cc-hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .cc-button {
    width: 100%;
  }

  .cc-home-feature::before {
    left: -15px;
    bottom: -25px;
    font-size: 8rem;
  }

  .cc-home-snapshot-card {
    min-height: 160px;
  }

  .cc-home-cta::after {
    right: -20px;
    bottom: -35px;
    font-size: 12rem;
  }

}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {

  .cc-button,
  .cc-home-quicklink-arrow,
  .cc-home-feature-image,
  .cc-text-link,
  .cc-text-link span,
  .cc-home-snapshot-card,
  .cc-home-snapshot-card b,
  .cc-footer a {
    transition: none !important;
  }

}

/* =========================================================
