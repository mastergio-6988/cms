/* ==============================================================
   CAMPUSCONNECT — LAYER 5D
   MASTER GLOBAL VISUAL ENHANCEMENT
   Presentation-only.
   ============================================================== */


/* --------------------------------------------------------------
   GLOBAL DESIGN FOUNDATION
   -------------------------------------------------------------- */

html {
  scroll-behavior: smooth;
}

body {
  background:
    linear-gradient(
      180deg,
      #f7f9fc 0%,
      #ffffff 28%,
      #f5f8fb 100%
    );
  color: #142846;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

::selection {
  background: rgba(25, 118, 210, 0.20);
  color: #102a4a;
}

a {
  text-underline-offset: 3px;
}


/* --------------------------------------------------------------
   SITE CONTAINER
   -------------------------------------------------------------- */

.cc-site {
  min-height: 100vh;
  overflow-x: hidden;
}

.cc-main {
  position: relative;
  isolation: isolate;
}


/* --------------------------------------------------------------
   HEADER — PREMIUM UNIVERSITY NAVIGATION
   -------------------------------------------------------------- */

.cc-header {
  position: relative;
  z-index: 100;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid rgba(20, 50, 85, 0.10);
  box-shadow:
    0 8px 30px rgba(15, 42, 72, 0.045);
}

.cc-header a {
  transition:
    color 160ms ease,
    opacity 160ms ease,
    transform 160ms ease;
}

.cc-header a:hover {
  opacity: 1;
}


/* --------------------------------------------------------------
   BRAND
   -------------------------------------------------------------- */

.cc-header .cc-brand,
.cc-brand {
  transition: transform 180ms ease;
}

.cc-brand:hover {
  transform: translateY(-1px);
}

.cc-brand-mark {
  box-shadow:
    0 8px 20px rgba(25, 118, 210, 0.18);
}


/* --------------------------------------------------------------
   MAIN NAVIGATION
   -------------------------------------------------------------- */

.cc-nav a,
.cc-header nav a {
  position: relative;
  font-weight: 650;
}

.cc-nav a::after,
.cc-header nav a::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -9px;
  height: 2px;
  transform: scaleX(0);
  transform-origin: center;
  background:
    linear-gradient(
      90deg,
      #1976d2,
      #4f46e5
    );
  border-radius: 99px;
  transition: transform 180ms ease;
}

.cc-nav a:hover::after,
.cc-header nav a:hover::after,
.cc-nav a.is-active::after,
.cc-header nav a.is-active::after {
  transform: scaleX(1);
}


/* --------------------------------------------------------------
   SEARCH
   -------------------------------------------------------------- */

.cc-search-panel {
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    0 20px 60px rgba(10, 35, 65, 0.16);
}


/* --------------------------------------------------------------
   PAGE CONTENT
   -------------------------------------------------------------- */

.cc-main > .cc-highlighted,
.cc-main > .cc-breadcrumb,
.cc-main > .cc-page-heading {
  max-width: 1240px;
  margin-left: auto;
  margin-right: auto;
}


/* --------------------------------------------------------------
   FOOTER — STRONGER FINISH
   -------------------------------------------------------------- */

.cc-footer {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      #0d2747,
      #102f55 48%,
      #123f68
    );
}

.cc-footer::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -220px;
  top: -280px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow:
    0 0 0 70px rgba(255, 255, 255, 0.025),
    0 0 0 140px rgba(255, 255, 255, 0.018);
  pointer-events: none;
}

.cc-footer > * {
  position: relative;
  z-index: 1;
}

.cc-footer a {
  transition:
    color 160ms ease,
    opacity 160ms ease,
    transform 160ms ease;
}

.cc-footer a:hover {
  opacity: 1;
  transform: translateX(2px);
}


/* --------------------------------------------------------------
   FOCUS ACCESSIBILITY
   -------------------------------------------------------------- */

:focus-visible {
  outline: 3px solid rgba(25, 118, 210, 0.55);
  outline-offset: 4px;
  border-radius: 4px;
}


/* --------------------------------------------------------------
   REDUCED MOTION
   -------------------------------------------------------------- */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}


/* --------------------------------------------------------------
   MOBILE HEADER
   -------------------------------------------------------------- */

@media (max-width: 900px) {

  .cc-header {
    box-shadow:
      0 5px 22px rgba(15, 42, 72, 0.07);
  }

  .cc-nav a::after,
  .cc-header nav a::after {
    display: none;
  }
}


