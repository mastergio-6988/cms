/* ==========================================================
   CAMPUSCONNECT — CLEAN HIGHER EDUCATION FRONTEND
   ========================================================== */

:root {
  --cc-navy: #102b4c;
  --cc-blue: #1769aa;
  --cc-blue-dark: #0b4f86;
  --cc-sky: #eaf4fb;
  --cc-purple: #4d3b78;
  --cc-paper: #f7f6f1;
  --cc-white: #ffffff;
  --cc-text: #203247;
  --cc-muted: #68798b;
  --cc-line: #dce3e9;
  --cc-shadow: 0 22px 55px rgba(16, 43, 76, .13);
  --cc-radius: 22px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cc-paper);
  color: var(--cc-text);
  font-family:
    Inter, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.65;
}

a {
  color: inherit;
}

img {
  max-width: 100%;
  height: auto;
}

.cc-site {
  min-height: 100vh;
  overflow: visible;
}

.cc-container {
  width: min(1240px, calc(100% - 48px));
  margin-inline: auto;
}

/* Utility */

.cc-utility {
  background: var(--cc-navy);
  color: #fff;
  font-size: 12px;
}

.cc-utility-inner {
  min-height: 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.cc-utility nav {
  display: flex;
  gap: 24px;
}

.cc-utility a {
  text-decoration: none;
  opacity: .9;
}

.cc-utility a:hover {
  opacity: 1;
}

/* Navigation */

.cc-nav-wrap {
  background: rgba(255,255,255,.97);
  border-bottom: 1px solid var(--cc-line);
  position: relative;
  z-index: 50;
}

.cc-nav {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

.cc-brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: var(--cc-navy);
}

.cc-brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--cc-blue);
  color: #fff;
  font-weight: 800;
  font-size: 22px;
}

.cc-brand strong,
.cc-brand small {
  display: block;
}

.cc-brand strong {
  font-size: 18px;
  letter-spacing: -.025em;
}

.cc-brand small {
  color: var(--cc-muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .14em;
}

.cc-main-nav {
  display: flex;
  align-items: center;
  gap: 25px;
}

.cc-main-nav a,
.cc-search-button {
  border: 0;
  background: transparent;
  text-decoration: none;
  font: inherit;
  font-size: 14px;
  font-weight: 650;
  color: var(--cc-navy);
  cursor: pointer;
}

.cc-main-nav a:hover,
.cc-search-button:hover {
  color: var(--cc-blue);
}

.cc-search-button {
  border-left: 1px solid var(--cc-line);
  padding-left: 24px;
}

.cc-menu-toggle {
  display: none;
  border: 1px solid var(--cc-line);
  background: #fff;
  border-radius: 10px;
  padding: 9px 13px;
  font-weight: 700;
}

/* Search */

.cc-search-panel {
  background: #fff;
  border-bottom: 1px solid var(--cc-line);
  padding: 28px 0;
  position: relative;
  z-index: 40;
}

.cc-search-panel[hidden] {
  display: none;
}

.cc-search-panel label {
  display: block;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--cc-blue);
  margin-bottom: 10px;
}

.cc-search-row {
  display: flex;
  gap: 10px;
}

.cc-search-row input {
  flex: 1;
  border: 1px solid var(--cc-line);
  border-radius: 12px;
  padding: 14px 16px;
  font: inherit;
  background: #fafcfd;
}

.cc-search-row button {
  border: 0;
  border-radius: 12px;
  padding: 0 24px;
  background: var(--cc-blue);
  color: #fff;
  font-weight: 800;
}

/* Hero */

.cc-hero {
  position: relative;
  min-height: 680px;
  isolation: isolate;
  overflow: hidden;
  background: var(--cc-navy);
  color: #fff;
}

.cc-hero-image {
  position: absolute;
  inset: 0;
  z-index: -3;
  background:
    linear-gradient(
      90deg,
      rgba(8,31,56,.94) 0%,
      rgba(8,31,56,.72) 42%,
      rgba(8,31,56,.18) 100%
    ),
    url("../images/campus/campus-aerial.jpg") center / cover no-repeat;
}

.cc-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(
      135deg,
      transparent 0 60%,
      rgba(23,105,170,.48) 60% 75%,
      rgba(77,59,120,.65) 75% 100%
    );
  pointer-events: none;
}

.cc-hero-shape {
  position: absolute;
  z-index: -1;
  pointer-events: none;
}

.cc-hero-shape-one {
  width: 360px;
  height: 360px;
  right: -120px;
  bottom: -150px;
  border-radius: 50%;
  border: 80px solid rgba(255,255,255,.11);
}

.cc-hero-shape-two {
  width: 240px;
  height: 240px;
  right: 15%;
  top: -150px;
  transform: rotate(18deg);
  border: 1px solid rgba(255,255,255,.22);
}

.cc-hero-inner {
  min-height: 680px;
  display: flex;
  align-items: center;
}

.cc-hero-copy {
  width: min(720px, 100%);
  padding: 80px 0;
}

.cc-eyebrow {
  display: inline-block;
  margin-bottom: 18px;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.cc-hero-copy .cc-eyebrow {
  color: #b9e2ff;
}

.cc-hero h1 {
  max-width: 780px;
  margin: 0;
  font-size: clamp(54px, 8vw, 108px);
  line-height: .91;
  letter-spacing: -.065em;
}

.cc-hero p {
  max-width: 620px;
  margin: 30px 0 0;
  font-size: clamp(17px, 2vw, 21px);
  color: rgba(255,255,255,.88);
}

.cc-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 34px;
}

.cc-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  padding: 0 22px;
  border-radius: 11px;
  text-decoration: none;
  font-weight: 800;
  transition: transform .2s ease, background .2s ease;
}

.cc-button:hover {
  transform: translateY(-2px);
}

.cc-button-primary {
  background: #fff;
  color: var(--cc-navy);
}

.cc-button-light {
  border: 1px solid rgba(255,255,255,.4);
  color: #fff;
  background: rgba(255,255,255,.08);
}

/* Quick links */

.cc-quicklinks {
  position: relative;
  z-index: 5;
  margin-top: -48px;
}

.cc-quicklinks-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #fff;
  border-radius: var(--cc-radius);
  box-shadow: var(--cc-shadow);
  overflow: hidden;
}

.cc-quicklinks a {
  min-height: 150px;
  padding: 25px;
  text-decoration: none;
  border-right: 1px solid var(--cc-line);
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: background .25s ease, transform .25s ease;
}

.cc-quicklinks a:last-child {
  border-right: 0;
}

.cc-quicklinks a:hover {
  background: var(--cc-sky);
}

.cc-quicklinks span {
  color: var(--cc-blue);
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .12em;
}

.cc-quicklinks strong {
  margin-top: 8px;
  color: var(--cc-navy);
  font-size: 19px;
}

.cc-quicklinks small {
  color: var(--cc-muted);
}

/* Main content */

.cc-content {
  position: relative;
  z-index: 2;
  padding-top: 78px;
  padding-bottom: 80px;
}

.cc-breadcrumb {
  margin-bottom: 20px;
  color: var(--cc-muted);
  font-size: 13px;
}

.cc-page-heading {
  margin-bottom: 35px;
}

.cc-page-heading h1,
.cc-page-heading {
  color: var(--cc-navy);
  font-size: clamp(42px, 6vw, 78px);
  line-height: .95;
  letter-spacing: -.055em;
  font-weight: 800;
}

.cc-content-area {
  min-width: 0;
  position: relative;
}

/* Prevent overlay/stacking bugs */

.cc-content-area > *,
.cc-content-area article,
.cc-content-area section,
.cc-content-area .cc-list-page {
  position: relative;
  z-index: 1;
}

.cc-content-area::after {
  content: "";
  display: table;
  clear: both;
}

/* Feature */

.cc-feature-strip {
  padding: 100px 0;
  background: #fff;
  border-top: 1px solid var(--cc-line);
}

.cc-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 70px;
  align-items: center;
}

.cc-feature-copy h2 {
  max-width: 650px;
  margin: 0;
  color: var(--cc-navy);
  font-size: clamp(38px, 5vw, 68px);
  line-height: .98;
  letter-spacing: -.055em;
}

.cc-feature-copy p {
  max-width: 620px;
  margin: 24px 0;
  color: var(--cc-muted);
  font-size: 17px;
}

.cc-feature-copy .cc-eyebrow {
  color: var(--cc-blue);
}

.cc-text-link {
  color: var(--cc-blue);
  font-weight: 850;
  text-decoration: none;
}

.cc-feature-photo {
  min-height: 480px;
  border-radius: 28px;
  background:
    linear-gradient(135deg, rgba(16,43,76,.05), rgba(23,105,170,.12)),
    url("../images/campus/campus-life.jpg") center / cover no-repeat;
  box-shadow: var(--cc-shadow);
}

/* Footer */

.cc-footer {
  background: var(--cc-navy);
  color: rgba(255,255,255,.76);
  padding: 70px 0;
}

.cc-footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 45px;
}

.cc-footer strong,
.cc-footer-brand {
  display: block;
  color: #fff;
  font-weight: 850;
  margin-bottom: 14px;
}

.cc-footer-brand {
  font-size: 23px;
}

.cc-footer p {
  margin: 0;
}

.cc-footer a,
.cc-footer span:not(.cc-footer-brand) {
  display: block;
  margin-top: 8px;
  color: rgba(255,255,255,.68);
  text-decoration: none;
  font-size: 14px;
}

.cc-footer a:hover {
  color: #fff;
}

/* Mobile */

@media (max-width: 980px) {

  .cc-main-nav {
    gap: 14px;
  }

  .cc-main-nav a {
    font-size: 13px;
  }

  .cc-quicklinks-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .cc-quicklinks a:nth-child(2) {
    border-right: 0;
  }

  .cc-quicklinks a:nth-child(-n+2) {
    border-bottom: 1px solid var(--cc-line);
  }

  .cc-feature-grid {
    gap: 40px;
  }

  .cc-footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 760px) {

  .cc-container {
    width: min(100% - 32px, 1240px);
  }

  .cc-utility-inner {
    min-height: 34px;
  }

  .cc-utility nav {
    display: none;
  }

  .cc-nav {
    min-height: 70px;
  }

  .cc-menu-toggle {
    display: block;
  }

  .cc-main-nav {
    display: none;
    position: absolute;
    left: 16px;
    right: 16px;
    top: 70px;
    padding: 12px;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: #fff;
    border: 1px solid var(--cc-line);
    border-radius: 14px;
    box-shadow: var(--cc-shadow);
  }

  .cc-main-nav.is-open {
    display: flex;
  }

  .cc-main-nav a,
  .cc-search-button {
    padding: 12px;
    border: 0;
  }

  .cc-search-button {
    text-align: left;
    padding-left: 12px;
  }

  .cc-hero,
  .cc-hero-inner {
    min-height: 590px;
  }

  .cc-hero h1 {
    font-size: clamp(50px, 15vw, 78px);
  }

  .cc-quicklinks {
    margin-top: -25px;
  }

  .cc-quicklinks-grid {
    grid-template-columns: 1fr;
  }

  .cc-quicklinks a {
    border-right: 0;
    border-bottom: 1px solid var(--cc-line);
  }

  .cc-quicklinks a:last-child {
    border-bottom: 0;
  }

  .cc-feature-grid {
    grid-template-columns: 1fr;
  }

  .cc-feature-photo {
    min-height: 340px;
  }

  .cc-footer-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   CAMPUSCONNECT — FACULTY & STAFF EDITORIAL EXPERIENCE
   ========================================================= */

.cc-list-page--faculty-staff {
  background:
    linear-gradient(180deg, #f7f9fc 0%, #ffffff 42%, #f3f5f9 100%);
  padding-bottom: 5rem;
}

/* Large editorial introduction */
.cc-list-page--faculty-staff .cc-list-header {
  max-width: 1180px;
  margin: 0 auto;
  padding: clamp(4rem, 8vw, 7rem) 2rem 3rem;
  position: relative;
}

.cc-list-page--faculty-staff .cc-list-header::after {
  content: "PEOPLE";
  position: absolute;
  right: 2rem;
  top: 3rem;
  font-size: clamp(4rem, 10vw, 9rem);
  line-height: .8;
  font-weight: 900;
  letter-spacing: -.08em;
  color: rgba(35, 61, 110, .045);
  pointer-events: none;
}

.cc-list-page--faculty-staff .cc-section-label {
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  color: #3157a6;
  font-size: .78rem;
  font-weight: 800;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.cc-list-page--faculty-staff .cc-section-label::before {
  content: "";
  width: 30px;
  height: 3px;
  background: #3157a6;
  border-radius: 99px;
}

.cc-list-page--faculty-staff .cc-list-header h1 {
  max-width: 850px;
  margin: 1rem 0 1.2rem;
  color: #14233f;
  font-size: clamp(3rem, 7vw, 6.5rem);
  line-height: .94;
  letter-spacing: -.055em;
}

.cc-list-page--faculty-staff .cc-list-header p {
  max-width: 720px;
  margin: 0;
  color: #53627a;
  font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  line-height: 1.75;
}

/* Header pills */
.cc-list-page--faculty-staff .cc-list-header-pills {
  display: flex;
  flex-wrap: wrap;
  gap: .65rem;
  margin-top: 2rem;
}

.cc-list-page--faculty-staff .cc-list-header-pills span {
  padding: .65rem .9rem;
  border: 1px solid #d9e0ec;
  border-radius: 999px;
  background: rgba(255,255,255,.8);
  color: #40516d;
  font-size: .78rem;
  font-weight: 700;
}

/* Staff grid */
.cc-list-page--faculty-staff .cc-list-grid {
  width: min(1180px, calc(100% - 4rem));
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 1.5rem;
}

/* Four staff cards */
.cc-list-page--faculty-staff .cc-list-card {
  grid-column: span 6;
  display: grid;
  grid-template-columns: minmax(190px, 42%) 1fr;
  min-height: 330px;
  overflow: hidden;
  position: relative;
  border: 1px solid #dfe5ee;
  border-radius: 4px;
  background: #fff;
  box-shadow: 0 18px 45px rgba(20, 35, 63, .08);
  transition:
    transform .3s ease,
    box-shadow .3s ease;
}

.cc-list-page--faculty-staff .cc-list-card:hover {
  transform: translateY(-7px);
  box-shadow: 0 25px 55px rgba(20, 35, 63, .14);
}

/* Image area */
.cc-list-page--faculty-staff .cc-list-card > :first-child {
  min-height: 330px;
  height: 100%;
  overflow: hidden;
  background: #dfe7f3;
}

.cc-list-page--faculty-staff .cc-list-card img {
  width: 100%;
  height: 100%;
  min-height: 330px;
  object-fit: cover;
  display: block;
  transition: transform .6s cubic-bezier(.2,.7,.2,1);
}

.cc-list-page--faculty-staff .cc-list-card:hover img {
  transform: scale(1.06);
}

/* Content */
.cc-list-page--faculty-staff .cc-list-card-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 2rem;
}

.cc-list-page--faculty-staff .cc-card-type {
  margin-bottom: .75rem;
  color: #3157a6;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.cc-list-page--faculty-staff .cc-list-card h2 {
  margin: 0 0 .75rem;
  color: #172844;
  font-size: clamp(1.55rem, 2.5vw, 2.1rem);
  line-height: 1.05;
  letter-spacing: -.035em;
}

.cc-list-page--faculty-staff .cc-list-card h2 a {
  color: inherit;
  text-decoration: none;
}

.cc-list-page--faculty-staff .cc-list-card h2 a:hover {
  color: #3157a6;
}

.cc-list-page--faculty-staff .cc-list-card p {
  margin: 0;
  color: #5b6980;
  font-size: .94rem;
  line-height: 1.7;
}

.cc-list-page--faculty-staff .cc-read-more {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  margin-top: 1.4rem;
  color: #172844;
  font-size: .82rem;
  font-weight: 800;
  text-decoration: none;
}

.cc-list-page--faculty-staff .cc-read-more span {
  transition: transform .2s ease;
}

.cc-list-page--faculty-staff .cc-list-card:hover .cc-read-more span {
  transform: translateX(5px);
}

/* Editorial stagger */
.cc-list-page--faculty-staff .cc-list-card:nth-child(2) {
  transform: translateY(2.5rem);
}

.cc-list-page--faculty-staff .cc-list-card:nth-child(2):hover {
  transform: translateY(calc(2.5rem - 7px));
}

.cc-list-page--faculty-staff .cc-list-card:nth-child(3) {
  margin-top: 2.5rem;
}

.cc-list-page--faculty-staff .cc-list-card:nth-child(4) {
  margin-top: 5rem;
}

/* Accent strip */
.cc-list-page--faculty-staff .cc-list-card::before {
  content: "";
  position: absolute;
  z-index: 3;
  left: 0;
  top: 0;
  width: 5px;
  height: 100%;
  background: #3157a6;
}

/* Mobile */
@media (max-width: 850px) {
  .cc-list-page--faculty-staff .cc-list-header {
    padding-top: 3.5rem;
  }

  .cc-list-page--faculty-staff .cc-list-header::after {
    display: none;
  }

  .cc-list-page--faculty-staff .cc-list-grid {
    width: min(100% - 2rem, 650px);
    display: grid;
    grid-template-columns: 1fr;
  }

  .cc-list-page--faculty-staff .cc-list-card,
  .cc-list-page--faculty-staff .cc-list-card:nth-child(2),
  .cc-list-page--faculty-staff .cc-list-card:nth-child(3),
  .cc-list-page--faculty-staff .cc-list-card:nth-child(4) {
    grid-column: 1;
    margin-top: 0;
    transform: none;
  }

  .cc-list-page--faculty-staff .cc-list-card:nth-child(2):hover {
    transform: translateY(-7px);
  }
}

@media (max-width: 560px) {
  .cc-list-page--faculty-staff .cc-list-card {
    grid-template-columns: 1fr;
  }

  .cc-list-page--faculty-staff .cc-list-card > :first-child,
  .cc-list-page--faculty-staff .cc-list-card img {
    min-height: 280px;
    height: 280px;
  }

  .cc-list-page--faculty-staff .cc-list-card-content {
    padding: 1.5rem;
  }
}


/* =========================================================
   CAMPUSCONNECT — EDITORIAL CONTENT PAGES
   Announcements / News / Events / Departments
   ========================================================= */

.cc-list-page {
  background: #f6f8fb;
  padding-bottom: 6rem;
}

/* Editorial page header */
.cc-list-header {
  width: min(1180px, calc(100% - 4rem));
  margin: 0 auto;
  padding: clamp(4rem, 8vw, 7rem) 0 3.5rem;
  position: relative;
}

.cc-list-header::after {
  content: "CAMPUS";
  position: absolute;
  right: 0;
  top: 3rem;
  color: rgba(35, 61, 110, .035);
  font-size: clamp(4rem, 11vw, 10rem);
  font-weight: 900;
  letter-spacing: -.08em;
  line-height: .8;
  pointer-events: none;
}

.cc-section-label {
  display: inline-flex;
  align-items: center;
  gap: .6rem;
  color: #3157a6;
  font-size: .72rem;
  font-weight: 850;
  letter-spacing: .15em;
  text-transform: uppercase;
}

.cc-section-label::before {
  content: "";
  width: 30px;
  height: 3px;
  border-radius: 99px;
  background: #3157a6;
}

.cc-list-header h1 {
  max-width: 850px;
  margin: 1rem 0;
  color: #14233f;
  font-size: clamp(3rem, 7vw, 6.5rem);
  line-height: .92;
  letter-spacing: -.06em;
}

