/* =========================================================
   CAMPUSCONNECT — PREMIUM NAVIGATION
   Lightweight / CSS-first / Drupal 11
   ========================================================= */

.cc-header[data-cc-header] {
  position: relative;
  z-index: 1000;
}

/* ---------- Utility bar ---------- */

.cc-header[data-cc-header] .cc-utility {
  min-height: 34px;
  background: #111827;
  color: rgba(255,255,255,.72);
  font-size: .76rem;
  letter-spacing: .035em;
}

.cc-header[data-cc-header] .cc-utility-inner {
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.cc-header[data-cc-header] .cc-utility-brand {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  font-weight: 600;
}

.cc-header[data-cc-header] .cc-utility-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 0 3px rgba(56,189,248,.12);
}

.cc-header[data-cc-header] .cc-utility-nav {
  display: flex;
  align-items: center;
  gap: 1.15rem;
}

.cc-header[data-cc-header] .cc-utility-nav a {
  color: inherit;
  text-decoration: none;
  transition: color .18s ease;
}

.cc-header[data-cc-header] .cc-utility-nav a:hover,
.cc-header[data-cc-header] .cc-utility-nav a:focus-visible {
  color: #fff;
}

/* ---------- Main navigation ---------- */

.cc-header[data-cc-header] .cc-nav-wrap {
  position: sticky;
  top: 0;
  z-index: 1001;
  background: rgba(255,255,255,.94);
  border-bottom: 1px solid rgba(15,23,42,.08);
  box-shadow: 0 4px 18px rgba(15,23,42,.045);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transition:
    box-shadow .22s ease,
    background-color .22s ease,
    border-color .22s ease;
}

.cc-header[data-cc-header].is-scrolled .cc-nav-wrap {
  background: rgba(255,255,255,.98);
  border-bottom-color: rgba(15,23,42,.12);
  box-shadow: 0 10px 30px rgba(15,23,42,.10);
}

.cc-header[data-cc-header] .cc-nav {
  min-height: 76px;
  display: flex;
  align-items: center;
  gap: 2rem;
}

/* ---------- Brand ---------- */

.cc-header[data-cc-header] .cc-brand {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: .75rem;
  color: #111827;
  text-decoration: none;
}

.cc-header[data-cc-header] .cc-brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg,#0f172a,#1e3a8a);
  color: #fff;
  font-size: 1.15rem;
  font-weight: 800;
  box-shadow:
    0 7px 18px rgba(30,58,138,.22),
    inset 0 1px 0 rgba(255,255,255,.18);
  transition: transform .2s ease, box-shadow .2s ease;
}

.cc-header[data-cc-header] .cc-brand:hover .cc-brand-mark {
  transform: translateY(-1px);
  box-shadow:
    0 10px 22px rgba(30,58,138,.28),
    inset 0 1px 0 rgba(255,255,255,.18);
}

.cc-header[data-cc-header] .cc-brand-copy {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.cc-header[data-cc-header] .cc-brand-copy strong {
  font-size: 1rem;
  letter-spacing: -.015em;
}

.cc-header[data-cc-header] .cc-brand-copy small {
  margin-top: .24rem;
  color: #64748b;
  font-size: .68rem;
  font-weight: 600;
  letter-spacing: .10em;
  text-transform: uppercase;
}

/* ---------- Main links ---------- */

.cc-header[data-cc-header] .cc-main-nav {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.cc-header[data-cc-header] .cc-main-nav-links {
  display: flex;
  align-items: center;
  gap: .15rem;
}

.cc-header[data-cc-header] .cc-main-nav-links a {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 76px;
  padding: 0 .72rem;
  color: #475569;
  font-size: .87rem;
  font-weight: 650;
  text-decoration: none;
  white-space: nowrap;
  transition: color .18s ease;
}

.cc-header[data-cc-header] .cc-main-nav-links a::after {
  content: "";
  position: absolute;
  left: .72rem;
  right: .72rem;
  bottom: 0;
  height: 3px;
  border-radius: 3px 3px 0 0;
  background: #2563eb;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform .2s ease;
}

.cc-header[data-cc-header] .cc-main-nav-links a:hover,
.cc-header[data-cc-header] .cc-main-nav-links a:focus-visible,
.cc-header[data-cc-header] .cc-main-nav-links a[aria-current="page"] {
  color: #0f172a;
}

.cc-header[data-cc-header] .cc-main-nav-links a:hover::after,
.cc-header[data-cc-header] .cc-main-nav-links a:focus-visible::after,
.cc-header[data-cc-header] .cc-main-nav-links a[aria-current="page"]::after {
  transform: scaleX(1);
}

/* ---------- Search ---------- */

.cc-header[data-cc-header] .cc-search-button {
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  gap: .55rem;
  padding: 0 .95rem;
  border: 1px solid rgba(15,23,42,.11);
  border-radius: 11px;
  background: #f8fafc;
  color: #334155;
  font: inherit;
  font-size: .82rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    background-color .18s ease,
    border-color .18s ease,
    box-shadow .18s ease,
    transform .18s ease;
}

.cc-header[data-cc-header] .cc-search-button:hover,
.cc-header[data-cc-header] .cc-search-button:focus-visible {
  background: #fff;
  border-color: rgba(37,99,235,.30);
  box-shadow: 0 5px 15px rgba(15,23,42,.08);
  transform: translateY(-1px);
}

.cc-header[data-cc-header] .cc-search-icon {
  position: relative;
  width: 14px;
  height: 14px;
  border: 2px solid currentColor;
  border-radius: 50%;
}

.cc-header[data-cc-header] .cc-search-icon::after {
  content: "";
  position: absolute;
  width: 6px;
  height: 2px;
  right: -5px;
  bottom: -2px;
  border-radius: 2px;
  background: currentColor;
  transform: rotate(45deg);
}

/* ---------- Search panel ---------- */

.cc-header[data-cc-header] .cc-search-panel {
  position: relative;
  background: #fff;
  border-bottom: 1px solid rgba(15,23,42,.08);
  box-shadow: 0 14px 28px rgba(15,23,42,.08);
}

.cc-header[data-cc-header] .cc-search-panel form {
  max-width: 900px;
  margin: 0 auto;
  padding: 1.5rem 0 1.7rem;
}

.cc-header[data-cc-header] .cc-search-panel label {
  display: block;
  margin-bottom: .65rem;
  color: #334155;
  font-size: .78rem;
  font-weight: 750;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.cc-header[data-cc-header] .cc-search-row {
  display: flex;
  gap: .65rem;
}

.cc-header[data-cc-header] .cc-search-row input {
  flex: 1;
  min-height: 48px;
  padding: 0 1rem;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  background: #f8fafc;
  color: #0f172a;
  font: inherit;
}

.cc-header[data-cc-header] .cc-search-row input:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 4px rgba(37,99,235,.10);
}

.cc-header[data-cc-header] .cc-search-row button {
  min-height: 48px;
  padding: 0 1.25rem;
  border: 0;
  border-radius: 10px;
  background: #1d4ed8;
  color: #fff;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

/* ---------- Mobile menu ---------- */

.cc-header[data-cc-header] .cc-menu-toggle {
  display: none;
  margin-left: auto;
  align-items: center;
  gap: .55rem;
  min-height: 42px;
  padding: 0 .8rem;
  border: 1px solid rgba(15,23,42,.12);
  border-radius: 10px;
  background: #fff;
  color: #0f172a;
  font: inherit;
  font-size: .82rem;
  font-weight: 700;
  cursor: pointer;
}

.cc-header[data-cc-header] .cc-menu-icon {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.cc-header[data-cc-header] .cc-menu-icon i {
  display: block;
  width: 17px;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
}

/* ---------- Keyboard accessibility ---------- */

.cc-header[data-cc-header] a:focus-visible,
.cc-header[data-cc-header] button:focus-visible {
  outline: 3px solid rgba(37,99,235,.30);
  outline-offset: 3px;
}

