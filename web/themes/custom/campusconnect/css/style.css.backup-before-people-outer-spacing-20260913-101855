  }

  .cc-home-feature-copy h2 {
    font-size: 2.7rem;
  }

  .cc-home-snapshot-grid {
    grid-template-columns: 1fr;
  }

  .cc-home-snapshot-card {
    min-height: 165px;
  }

  .cc-home-cta {
    padding: 75px 0;
  }

  .cc-home-cta h2 {
    font-size: 4rem;
  }

  .cc-home-cta::after {
    right: -45%;
