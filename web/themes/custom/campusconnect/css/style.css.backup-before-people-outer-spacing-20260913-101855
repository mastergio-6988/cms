   ========================================================= */

@media (max-width: 520px) {

  .cc-utility-inner {
    min-height: 38px;
  }

  .cc-utility nav {
    display: none;
  }

  .cc-brand strong {
    font-size: .95rem;
  }

  .cc-brand small {
    font-size: .62rem;
  }

  .cc-brand-mark {
    width: 38px;
    height: 38px;
  }

  .cc-home-hero {
    min-height: 650px;
  }

  .cc-hero-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .cc-button {
    width: 100%;
  }

}


/* =========================================================
   ACCESSIBLE REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }

  .cc-home-section,
  .cc-list-card,
  .cc-home-quicklink,
  .cc-home-snapshot-card {
    opacity: 1 !important;
    transform: none !important;
  }

}


