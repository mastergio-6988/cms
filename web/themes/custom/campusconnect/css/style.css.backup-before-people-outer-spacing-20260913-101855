   ========================================================= */

a:focus-visible,
button:focus-visible,
input:focus-visible {
  outline: 3px solid #6b55e8;
  outline-offset: 3px;
}


/* Prevent accidental horizontal overflow */

html,
body {
  max-width: 100%;
