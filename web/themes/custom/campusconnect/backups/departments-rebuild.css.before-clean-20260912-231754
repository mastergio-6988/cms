.cc-departments-page {
  background: #f5f8fc;
  color: #0b315f;
}

.cc-departments-page *,
.cc-departments-page *::before,
.cc-departments-page *::after {
  box-sizing: border-box;
}

.cc-dept-hero {
  position: relative;
  max-width: 1240px;
  min-height: 385px;
  margin: 74px auto 30px;
  overflow: hidden;
  border: 1px solid #cfe3fa;
  border-radius: 24px;
  background:
    radial-gradient(circle at 0% 100%, rgba(204,232,255,.65), transparent 36%),
    linear-gradient(110deg, #eaf7ff 0%, #f8fbff 55%, #fff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.cc-dept-hero-watermark {
  position: absolute;
  top: -38px;
  left: 0;
  width: 100%;
  font-size: 124px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -7px;
  color: rgba(31,126,224,.055);
  white-space: nowrap;
  pointer-events: none;
}

.cc-dept-hero-content {
  position: relative;
  z-index: 2;
  max-width: 820px;
  padding: 68px 30px 54px;
}

.cc-dept-eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-bottom: 17px;
  color: #087cf0;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.cc-dept-eyebrow span {
  width: 29px;
  height: 2px;
  background: #86c6ff;
}

.cc-dept-hero h1 {
  margin: 0;
  color: #0b3e78;
  font-size: clamp(48px, 6vw, 62px);
  line-height: .98;
  letter-spacing: -2px;
}

.cc-dept-hero p {
  max-width: 740px;
  margin: 19px auto 21px;
  color: #507bad;
  font-size: 15px;
  line-height: 1.65;
}

.cc-dept-pills {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 9px;
}

.cc-dept-pills span {
  padding: 10px 15px;
  border: 1px solid #cce2fb;
  border-radius: 999px;
  background: rgba(255,255,255,.9);
  color: #1269c4;
  font-size: 11px;
  font-weight: 700;
}

.cc-dept-section {
  max-width: 1240px;
  margin: 0 auto;
  padding-bottom: 75px;
}

.cc-dept-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.cc-dept-card {
  overflow: hidden;
  border: 1px solid #d4dfeb;
  border-top: 3px solid #2858a8;
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 14px 35px rgba(24,63,106,.07);
  transition: transform .2s ease, box-shadow .2s ease;
}

.cc-dept-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 42px rgba(24,63,106,.13);
}

.cc-dept-image-wrap {
  position: relative;
  height: 244px;
  overflow: hidden;
  background: #dceaf5;
}

.cc-dept-image-wrap img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform .35s ease;
}

.cc-dept-card:hover .cc-dept-image-wrap img {
  transform: scale(1.035);
}

.cc-dept-image-dot {
  position: absolute;
  left: 12px;
  bottom: 10px;
  width: 13px;
  height: 13px;
  border: 4px solid rgba(255,255,255,.8);
  border-radius: 50%;
  background: #cfe0f0;
}

.cc-dept-card-body {
  position: relative;
  min-height: 300px;
  padding: 23px 21px 20px;
}

.cc-dept-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 11px;
}

.cc-dept-explore {
  padding: 8px 12px;
  border: 1px solid #bddcff;
  border-radius: 999px;
  color: #087cf0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.cc-dept-number {
  color: #e2effc;
  font-size: 29px;
  line-height: 1;
  font-weight: 800;
}

.cc-dept-card h2 {
  margin: 0 0 11px;
  color: #092f5e;
  font-size: 21px;
  line-height: 1.18;
}

.cc-dept-card p {
  margin: 0;
  color: #55779f;
  font-size: 13px;
  line-height: 1.7;
}

.cc-dept-story {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 25px;
  color: #063c78;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
}

.cc-dept-story:hover {
  color: #087cf0;
}

.cc-dept-label {
  margin-top: 27px;
  color: #91a9c2;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.cc-dept-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  padding: 28px;
}

.cc-dept-modal.is-open {
  display: flex;
  align-items: center;
  justify-content: center;
}

.cc-dept-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(5,30,57,.72);
  backdrop-filter: blur(5px);
}

.cc-dept-modal-dialog {
  position: relative;
  z-index: 2;
  width: min(1000px, 96vw);
  max-height: 90vh;
  overflow: auto;
  border: 1px solid #d4e7fa;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 30px 100px rgba(0,0,0,.3);
}

.cc-dept-modal-close {
  position: absolute;
  top: 16px;
  right: 17px;
  z-index: 4;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 50%;
  background: rgba(255,255,255,.92);
  color: #123f70;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
}

.cc-dept-modal-kicker {
  padding: 20px 28px 0;
  color: #087cf0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.7px;
}

.cc-dept-modal-layout {
  display: grid;
  grid-template-columns: 1.15fr .85fr;
  gap: 0;
}

.cc-dept-modal-copy {
  padding: 25px 34px 34px;
}

.cc-dept-modal-label {
  color: #087cf0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.cc-dept-modal-copy h2 {
  margin: 12px 0;
  color: #073d76;
  font-size: 38px;
  line-height: 1.05;
}

.cc-dept-modal-intro,
.cc-dept-modal-body {
  color: #52759d;
  font-size: 14px;
  line-height: 1.75;
}

.cc-dept-modal-body {
  margin-top: 13px;
}

.cc-dept-modal-highlights {
  margin-top: 22px;
}

.cc-dept-modal-highlights div {
  padding: 10px 0;
  border-top: 1px solid #e1ebf5;
  color: #194b7e;
  font-size: 12px;
  font-weight: 700;
}

.cc-dept-modal-image-wrap {
  min-height: 470px;
  background: #e6f1fa;
}

.cc-dept-modal-image {
  width: 100%;
  height: 100%;
  min-height: 470px;
  display: block;
  object-fit: cover;
}

body.cc-dept-modal-open {
  overflow: hidden;
}

@media (max-width: 950px) {
  .cc-dept-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cc-dept-modal-layout {
    grid-template-columns: 1fr;
  }

  .cc-dept-modal-image-wrap,
  .cc-dept-modal-image {
    min-height: 300px;
    height: 300px;
  }
}

@media (max-width: 680px) {
  .cc-dept-hero {
    margin: 30px 15px 24px;
    min-height: 350px;
  }

  .cc-dept-section {
    padding: 0 15px 50px;
  }

  .cc-dept-grid {
    grid-template-columns: 1fr;
  }

  .cc-dept-image-wrap {
    height: 230px;
  }

  .cc-dept-hero-watermark {
    font-size: 76px;
  }

  .cc-dept-modal {
    padding: 12px;
  }

  .cc-dept-modal-copy {
    padding: 23px;
  }

  .cc-dept-modal-copy h2 {
    font-size: 30px;
  }
}
