  private function getMediaImageData(int $media_id): ?array {
    $media = \Drupal::entityTypeManager()
      ->getStorage('media')
      ->load($media_id);

    if (!$media || $media->bundle() !== 'image' || !$media->hasField('field_media_image')) {
      return NULL;
    }

    $field = $media->get('field_media_image');

    if ($field->isEmpty() || !$file = $field->entity) {
      return NULL;
    }

    return [
      'url' => \Drupal::service('file_url_generator')
        ->generateString($file->getFileUri()),
      'alt' => $field->alt ?? '',
    ];
  }

private function getSummary(Node $node, int $limit): string {
    if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
      return 'Explore this campus update and stay connected with what matters.';
    }

    $text = trim(preg_replace('/\s+/', ' ', strip_tags($node->get('body')->value)));
    if (mb_strlen($text) > $limit) {
      return mb_substr($text, 0, $limit - 1) . '…';
    }
    return $text;
  }

  /**
   * Builds the image markup used by listing cards.
   */
private function getImageMarkup(Node $node, string $field_name, string $type, string $icon): string {

    /*
     * Announcement-specific visual mapping.
     * The image is selected automatically from the announcement title,
     * so different campus notices do not all display the same photograph.
     */
    if ($type === 'campus_news') {
      $title = mb_strtolower($node->label());

      /*
       * Automatically choose a visual based on the news title.
       */
      $news_image = '/sites/default/files/homepage-visuals/campus-news.jpg';

      if (preg_match('/student|achievement|award|competition|organization|club|graduat|scholar/', $title)) {
        $news_image = '/sites/default/files/homepage-visuals/student-experience.jpg';
      }
      elseif (preg_match('/research|study|innovation|technology|science|discovery|project/', $title)) {
        $news_image = '/sites/default/files/homepage-visuals/academic-communication.jpg';
      }
      elseif (preg_match('/faculty|professor|teacher|expert|staff|people/', $title)) {
        $news_image = '/sites/default/files/homepage-visuals/people-expertise.jpg';
      }
      elseif (preg_match('/community|outreach|service|partnership|community/', $title)) {
        $news_image = '/sites/default/files/homepage-visuals/connected-campus.jpg';
      }
      elseif (preg_match('/event|seminar|workshop|conference|festival|celebration/', $title)) {
        $news_image = '/sites/default/files/homepage-visuals/events.jpg';
      }

      return '<div class="cc-home-card-media cc-home-card-media--news">
        <img src="' . Html::escape($news_image) . '" alt="' . Html::escape($node->label()) . '" loading="lazy">
      </div>';
    }

    if ($type === 'announcement') {
      $title = mb_strtolower($node->label());

      $announcement_image = '/sites/default/files/homepage-visuals/announcements.jpg';

      if (preg_match('/enrollment|admission|registration|scholarship|student|student affairs|application/', $title)) {
        $announcement_image = '/sites/default/files/homepage-visuals/student-experience.jpg';
      }
      elseif (preg_match('/capstone|orientation|project|academic|course|class|faculty|exam|examination|deadline|semester/', $title)) {
        $announcement_image = '/sites/default/files/homepage-visuals/academic-communication.jpg';
      }
      elseif (preg_match('/internet|network|wifi|wi-fi|technology|system|maintenance|server|online|digital/', $title)) {
        $announcement_image = '/sites/default/files/homepage-visuals/connected-campus.jpg';
      }
      elseif (preg_match('/event|seminar|workshop|meeting|activity|celebration/', $title)) {
        $announcement_image = '/sites/default/files/homepage-visuals/events.jpg';
      }

      return '<div class="cc-home-card-media cc-home-card-media--announcement">
        <img src="' . Html::escape($announcement_image) . '" alt="' . Html::escape($node->label()) . '" loading="lazy">
      </div>';
    }

    if ($node->hasField($field_name) && !$node->get($field_name)->isEmpty() && $file = $node->get($field_name)->entity) {
      $url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());

      return '<div class="cc-home-card-media">
        <img src="' . Html::escape($url) . '" alt="' . Html::escape($node->label()) . '" loading="lazy">
      </div>';
    }

    // Use a Visual Manager image before falling back to the legacy local image.
    $visuals = \Drupal::config('campusconnect_home.visuals');
    $visual_key = $type . '_fallback';
    $media_id = $visuals->get($visual_key);

    if ($media_id && $configured = $this->getMediaImageData((int) $media_id)) {
      return '<div class="cc-home-card-media cc-home-card-media--configured">
        <img src="' . Html::escape($configured['url']) . '" alt="" loading="lazy">
      </div>';
    }

    // Legacy local fallbacks remain available when no reusable image is selected.
    $fallback_images = [
      'announcement' => '/themes/custom/campusconnect/images/campus/campus-aerial.jpg',
      'campus_news' => '/themes/custom/campusconnect/images/campus/campus-life.jpg',
      'campus_event' => '/themes/custom/campusconnect/images/campus/campus-aerial.jpg',
      'department' => '/themes/custom/campusconnect/images/campus/campus-life.jpg',
      'faculty_staff' => '/themes/custom/campusconnect/images/campus/campus-aerial.jpg',
    ];

    $fallback = $fallback_images[$type]
      ?? '/themes/custom/campusconnect/images/campus/campus-life.jpg';

    return '<div class="cc-home-card-media cc-home-card-media--fallback">
      <img src="' . Html::escape($fallback) . '" alt="" loading="lazy">
      <span class="cc-home-card-media-label" aria-hidden="true">' . Html::escape($icon) . '</span>
    </div>';
  }

  public function listing(string $type): array {
    if (!isset(self::CONTENT_AREAS[$type])) {
      throw new NotFoundHttpException();
    }

    $area = self::CONTENT_AREAS[$type];
    $ids = $this->entityTypeManager()->getStorage('node')->getQuery()
      ->condition('type', $type)
      ->condition('status', 1)
      ->accessCheck(TRUE)
      ->sort('created', 'DESC')
      ->execute();

    $items = [];
    foreach (Node::loadMultiple($ids) as $node) {
      $title = Html::escape($node->label());
      $url = Html::escape($node->toUrl()->toString());
      $items[] = [
        '#markup' => '
          <article class="cc-list-card">
            ' . $this->getImageMarkup($node, $area['image_field'], $type, $area['icon']) . '
            <div class="cc-list-card-content">
              <span class="cc-card-type">' . Html::escape($area['label']) . '</span>
              <h2><a href="' . $url . '">' . $title . '</a></h2>
              <p>' . Html::escape($this->getSummary($node, 180)) . '</p>
              <a class="cc-read-more" href="' . $url . '">View details <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ',
      ];
    }

    if (!$items) {
      $items[] = [
        '#markup' => '<div class="cc-list-empty"><span aria-hidden="true">' . Html::escape($area['icon']) . '</span><h2>Nothing here yet</h2><p>New ' . Html::escape($area['singular']) . ' updates will appear here soon.</p></div>',
      ];
    }

    return [
      '#type' => 'container',
      '#attributes' => ['class' => ['cc-list-page', 'cc-list-page--' . str_replace('_', '-', $type)]],
      'header' => ($type === 'announcement') ? [] : [
        '#markup' => '
          <header class="cc-list-header">
            <span class="cc-section-label">CampusConnect / ' . Html::escape($area['label']) . '</span>
            <h1>' . Html::escape($area['title']) . '</h1>
            <p>' . Html::escape($area['description']) . '</p>
            <div class="cc-list-header-pills">
              <span>Easy to explore</span>
              <span>University community</span>
              <span>CampusConnect</span>
            </div>
          </header>
        ',
      ],
      'items' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['cc-list-grid']],
        'content' => $items,
      ],
    ];
  }


