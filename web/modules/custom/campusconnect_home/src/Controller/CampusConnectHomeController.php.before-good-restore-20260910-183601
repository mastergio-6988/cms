  /**
   * Builds a single content strip for the home page.
   */
  private function buildHomeSection(string $type, array $area): array {
    $ids = $this->entityTypeManager()->getStorage('node')->getQuery()
      ->condition('type', $type)
      ->condition('status', 1)
      ->accessCheck(TRUE)
      ->sort('created', 'DESC')
      ->range(0, 3)
      ->execute();

    $cards = [];
    if ($ids) {
      foreach (Node::loadMultiple($ids) as $node) {
        $cards[] = $this->buildHomeCard($node, $type, $area);
      }
    }
    else {
      $cards[] = [
        '#markup' => '
          <article class="cc-home-card cc-home-card--empty">
            <div class="cc-empty-symbol" aria-hidden="true">' . $area['icon'] . '</div>
            <div class="cc-card-content">
              <span class="cc-card-type">Coming soon</span>
              <h3>More ' . Html::escape(strtolower($area['title'])) . ' are on their way.</h3>
              <p>Check back soon for the newest campus updates.</p>
              <a class="cc-read-more" href="' . $area['link'] . '">Explore this space <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ',
      ];
    }

    return [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['cc-home-section', 'cc-home-section--' . str_replace('_', '-', $type)],
      ],
      'heading' => [
        '#markup' => '
          <div class="cc-section-heading">
            <div>
              <span class="cc-section-label">' . Html::escape($area['label']) . '</span>
              <h2>' . Html::escape($area['title']) . '</h2>
            </div>
            <a class="cc-section-link" href="' . $area['link'] . '">View all <span aria-hidden="true">→</span></a>
          </div>
        ',
      ],
      'cards' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['cc-home-grid']],
        'items' => $cards,
      ],
    ];
  }

  /**
   * Produces a content card with a useful visual fallback for missing images.
   */
  private function buildHomeCard(Node $node, string $type, array $area): array {
    $title = Html::escape($node->label());
    $url = Html::escape($node->toUrl()->toString());
    $summary = $this->getSummary($node, 145);
    // ControllerBase does not expose a dateFormatter() convenience method.
    // Use Drupal's formatter service so cards render correctly on the live site.
    $date = \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'M j, Y');
    $image = $this->getImageMarkup($node, $area['image_field'], $type, $area['icon']);

    return [
      '#markup' => '
        <article class="cc-home-card">
          ' . $image . '
          <div class="cc-card-content">
            <div class="cc-card-meta"><span>' . Html::escape($area['label']) . '</span><time datetime="' . date('c', $node->getCreatedTime()) . '">' . Html::escape($date) . '</time></div>
            <h3><a href="' . $url . '">' . $title . '</a></h3>
            <p>' . Html::escape($summary) . '</p>
            <a class="cc-read-more" href="' . $url . '">Discover more <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ',
    ];
  }

  /**
   * Returns a teaser image or a deliberate visual fallback.
   */
  private function getImageMarkup(Node $node, string $field_name, string $type, string $icon): string {
    if ($node->hasField($field_name) && !$node->get($field_name)->isEmpty() && $file = $node->get($field_name)->entity) {
      $url = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
      return '<div class="cc-card-image"><img src="' . Html::escape($url) . '" alt="' . Html::escape($node->label()) . '" loading="lazy"></div>';
    }

    return '<div class="cc-card-image cc-card-image--fallback cc-card-image--' . Html::getClass($type) . '"><span aria-hidden="true">' . Html::escape($icon) . '</span></div>';
  }

  /**
   * Extracts a compact, readable description from the node body.
   */
  private function getSummary(Node $node, int $limit): string {
    if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
      return 'Explore this campus update and stay connected with what matters.';
    }

    $text = trim(preg_replace('/\s+/', ' ', strip_tags($node->get('body')->value)));
    if (mb_strlen($text) > $limit) {
      return mb_substr($text, 0, $limit - 1) . '…';
    }
    return $text;
  }

  /**
   * Counts visible content in each public campus area.
   */
  private function getContentCounts(): array {
    $counts = [];
    $storage = $this->entityTypeManager()->getStorage('node');
    foreach (self::CONTENT_AREAS as $type => $area) {
      $counts[$type] = (int) $storage->getQuery()
        ->condition('type', $type)
        ->condition('status', 1)
        ->accessCheck(TRUE)
        ->count()
        ->execute();
    }
    return $counts;
  }

  /**
   * Builds a clean listing page for a campus content area.
   */
  public function listing(string $type): array {
    if (!isset(self::CONTENT_AREAS[$type])) {
      throw new NotFoundHttpException();
    }

    $area = self::CONTENT_AREAS[$type];
    $ids = $this->entityTypeManager()->getStorage('node')->getQuery()
      ->condition('type', $type)
      ->condition('status', 1)
      ->accessCheck(TRUE)
      ->sort('created', 'DESC')
      ->execute();

    $items = [];
    foreach (Node::loadMultiple($ids) as $node) {
      $title = Html::escape($node->label());
      $url = Html::escape($node->toUrl()->toString());
      $items[] = [
        '#markup' => '
          <article class="cc-list-card">
            ' . $this->getImageMarkup($node, $area['image_field'], $type, $area['icon']) . '
            <div class="cc-list-card-content">
              <span class="cc-card-type">' . Html::escape($area['label']) . '</span>
              <h2><a href="' . $url . '">' . $title . '</a></h2>
              <p>' . Html::escape($this->getSummary($node, 180)) . '</p>
              <a class="cc-read-more" href="' . $url . '">View details <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ',
      ];
    }

    if (!$items) {
      $items[] = [
        '#markup' => '<div class="cc-list-empty"><span aria-hidden="true">' . Html::escape($area['icon']) . '</span><h2>Nothing here yet</h2><p>New ' . Html::escape($area['singular']) . ' updates will appear here soon.</p></div>',
      ];
    }

    return [
      '#type' => 'container',
      '#attributes' => ['class' => ['cc-list-page', 'cc-list-page--' . str_replace('_', '-', $type)]],
      'header' => [
        '#markup' => '
          <header class="cc-list-header">
            <span class="cc-section-label">CampusConnect / ' . Html::escape($area['label']) . '</span>
            <h1>' . Html::escape($area['title']) . '</h1>
            <p>' . Html::escape($area['description']) . '</p>
            <div class="cc-list-header-pills">
              <span>Easy to explore</span>
              <span>University community</span>
              <span>CampusConnect</span>
            </div>
          </header>
        ',
      ],
      'items' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['cc-list-grid']],
        'content' => $items,
      ],
    ];
  }


